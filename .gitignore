# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# SUMO outputs
*.xml.bak
*-output.xml
tripinfo.xml
*.sumocfg.bak

# Trained models / checkpoints — ignore intermediate ones, but the final
# shipped checkpoint (checkpoints/dqn_final.npz) is intentionally committed
# so the product is runnable without retraining. Add it with `git add -f`
# when it's ready (Week 6/10).
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/dqn_final.npz
!checkpoints/dqn_rush.npz
!checkpoints/dqn_mixed.npz

# Logs / data dumps
*.log
data/raw/

# OS / editor
.DS_Store
.vscode/
.idea/

# Client projects and training jobs (traffic-drl train-job / the app)
projects/
