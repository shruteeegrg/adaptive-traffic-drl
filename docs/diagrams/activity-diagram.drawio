<mxfile host="app.diagrams.net"><diagram id="activity-diagram" name="activity-diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Activity diagram: one training run&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1040" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Control flow of train_agent: episodes, decisions, learning and periodic evaluation." style="text;html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1040" height="24" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="435" y="80" width="30" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Load config, create environment and agent" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="130" width="320" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Reset episode: next scenario and seed, start SUMO" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="215" width="320" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Observe state (queues, waiting, phase, time in phase)" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="320" height="56" as="geometry"/></mxCell><mxCell id="c8" value="random &amp;lt; epsilon?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="385" width="260" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Explore: random action" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="240" height="56" as="geometry"/></mxCell><mxCell id="c10" value="Exploit: action with highest Q-value" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="260" height="56" as="geometry"/></mxCell><mxCell id="c11" value="Apply action: keep green or switch (insert 3 s yellow)" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="600" width="320" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Advance SUMO 5 s, add the cost every second" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="685" width="320" height="56" as="geometry"/></mxCell><mxCell id="c13" value="Compute reward, store transition in buffer" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="770" width="320" height="56" as="geometry"/></mxCell><mxCell id="c14" value="buffer has enough transitions?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="855" width="260" height="80" as="geometry"/></mxCell><mxCell id="c15" value="Learn: sample minibatch, update network, sync target every N steps" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="620" y="960" width="300" height="56" as="geometry"/></mxCell><mxCell id="c16" value="episode over (30 simulated min)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="1060" width="260" height="80" as="geometry"/></mxCell><mxCell id="c17" value="Decay epsilon, log episode metrics" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="1170" width="320" height="56" as="geometry"/></mxCell><mxCell id="c18" value="evaluate this episode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="1255" width="260" height="80" as="geometry"/></mxCell><mxCell id="c19" value="Greedy evaluation on unseen seeds; save checkpoint if best" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="620" y="1345" width="300" height="56" as="geometry"/></mxCell><mxCell id="c20" value="more episodes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="1430" width="260" height="80" as="geometry"/></mxCell><mxCell id="c21" value="Save final model and training log" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="1545" width="320" height="56" as="geometry"/></mxCell><mxCell id="c22" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="432" y="1630" width="36" height="36" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edg