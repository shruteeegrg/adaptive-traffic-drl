<mxfile host="app.diagrams.net"><diagram id="functional-architecture" name="functional-architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Functional architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1440" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Functions grouped in layers; each layer uses the one below." style="text;html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1440" height="24" as="geometry"/></mxCell><mxCell id="c4" value="1. Interface" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=40;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1440" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Command-line tool (traffic-drl)&lt;/b&gt;&lt;br&gt;env-check, train, sweep, baseline, evaluate,&lt;br&gt;plot, run (streams JSON lines), demo" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="620" height="95" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Streamlit demo app&lt;/b&gt;&lt;br&gt;live side-by-side run, junction drawing, counters and chart,&lt;br&gt;saved test results, how it works" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="680" height="95" as="geometry"/></mxCell><mxCell id="c7" value="2. Experiments" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=40;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="1440" height="180" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Training and evaluation loop&lt;/b&gt;&lt;br&gt;episodes, epsilon schedule, periodic greedy&lt;br&gt;evaluation on unseen seeds, best checkpoint" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="305" width="440" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Hyperparameter sweep&lt;/b&gt;&lt;br&gt;grid x seeds, per-run results, ranking,&lt;br&gt;resume after interruption" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="530" y="305" width="420" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Configuration and scenarios&lt;/b&gt;&lt;br&gt;YAML with inheritance, scenario list,&lt;br&gt;route generator (tidal, rush hour, low traffic)" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="980" y="305" width="460" height="110" as="geometry"/></mxCell><mxCell id="c11" value="3. Controllers and learning components" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=40;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1440" height="220" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;DQN agent&lt;/b&gt;&lt;br&gt;epsilon-greedy act, learn from minibatch,&lt;br&gt;target-network sync" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="280" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Q-table agent&lt;/b&gt;&lt;br&gt;bucketed state,&lt;br&gt;tabular update" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="365" y="515" width="220" height="150" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Fixed-time controller&lt;/b&gt;&lt;br&gt;40 s green per direction,&lt;br&gt;no learning" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="610" y="515" width="220" height="150" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Neural network library&lt;/b&gt;&lt;br&gt;MLP, backpropagation, Adam,&lt;br&gt;Huber / MSE loss" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="855" y="515" width="300" height="150" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Replay buffer&lt;/b&gt;&lt;br&gt;stored transitions,&lt;br&gt;random minibatches" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="1180" y="515" width="260" height="150" as="geometry"/></mxCell><mxCell id="c17" value="4. Simulation environment (TraciEnv)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=40;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1440" height="190" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;State sensing&lt;/b&gt;&lt;br&gt;queues, waiting time, phase,&lt;br&gt;time in phase, backlog" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="765" width="270" height="120" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Action execution&lt;/b&gt;&lt;br&gt;switch phase, insert 3 s yellow,&lt;br&gt;5 s decision interval" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="355" y="765" width="270" height="120" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Reward accounting&lt;/b&gt;&lt;br&gt;cost every simulated second,&lt;br&gt;switch penalty, scale" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="650" y="765" width="270" height="120" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Metrics&lt;/b&gt;&lt;br&gt;waiting, throughput,&lt;br&gt;switches" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="945" y="765" width="240" height="120" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Seeds and scenarios&lt;/b&gt;&lt;br&gt;per-episode seed,&lt;br&gt;scenario cycling" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="1210" y="765" width="230" height="120" as="geometry"/></mxCell><mxCell id="c23" value="5. Supporting: simulator and analysis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=40;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="940" width="1440" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;SUMO simulator, controlled through TraCI&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="975" width="560" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Analysis and visualisation:&lt;/b&gt; training curves, comparison charts and tables (matplotlib)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="660" y="975" width="780" height="50" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;roun