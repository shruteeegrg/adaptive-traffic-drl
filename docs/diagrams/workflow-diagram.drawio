<mxfile host="app.diagrams.net"><diagram id="workflow-diagram" name="workflow-diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2250" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Workflow: from idea to a result we trust&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="2190" height="30" as="geometry"/></mxCell><mxCell id="c3" value="The experiment loop used in this project. Checkpoints are chosen on one set of seeds and confirmed on fresh seeds." style="text;html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="2190" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1. Define&lt;/b&gt;&lt;br&gt;scenario and config&lt;br&gt;(YAML, routes)" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2. Check&lt;/b&gt;&lt;br&gt;env-check on SUMO,&lt;br&gt;run the tests" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3. Train&lt;/b&gt;&lt;br&gt;Q-table warm-up,&lt;br&gt;then DQN" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;4. Tune&lt;/b&gt;&lt;br&gt;sweep: settings x seeds,&lt;br&gt;look at switches too" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="750" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;5. Select&lt;/b&gt;&lt;br&gt;best checkpoint on&lt;br&gt;selection seeds" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="990" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;6. Confirm&lt;/b&gt;&lt;br&gt;evaluate on fresh seeds&lt;br&gt;(10 episodes)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="1230" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="c10" value="Better than (or tied with) the fixed timer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="90" width="260" height="160" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;7. Publish&lt;/b&gt;&lt;br&gt;plot, copy model to&lt;br&gt;checkpoints/, write up" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="1734" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;8. Demo&lt;/b&gt;&lt;br&gt;side-by-side app,&lt;br&gt;results tab" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="1974" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Fixed-time baseline&lt;/b&gt;&lt;br&gt;same seeds, same scenario" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="1230" y="330" width="200" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Diagnose&lt;/b&gt;&lt;br&gt;check switches, backlog,&lt;br&gt;reward design;&lt;br&gt;change setting or design" style="wh