<mxfile host="app.diagrams.net"><diagram id="class-diagram" name="class-diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Class diagram (traffic_drl)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1590" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Agents share one informal interface (act, decay_epsilon, save, load); DQNAgent owns the network, buffer and optimiser." style="text;html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1590" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;br&gt;&lt;b&gt;Agent&lt;/b&gt;&lt;hr&gt;&lt;hr&gt;act(state, greedy) : int&lt;br&gt;decay_epsilon()&lt;br&gt;save(path) / load(path)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="330" height="124" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;FixedTimeAgent&lt;/b&gt;&lt;hr&gt;green_steps : int&lt;br&gt;n_actions : int&lt;hr&gt;act(state, greedy) : int&lt;br&gt;reset()" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="310" height="124" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;QTableAgent&lt;/b&gt;&lt;hr&gt;queue_bins, alpha, gamma&lt;br&gt;epsilon, q : dict&lt;br&gt;n_actions : int&lt;hr&gt;discretize(state) : tuple&lt;br&gt;act(state, greedy) : int&lt;br&gt;update(s, a, r, s', done)&lt;br&gt;decay_epsilon()&lt;br&gt;save(path) / load(path)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="430" y="250" width="380" height="192" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;DQNAgent&lt;/b&gt;&lt;hr&gt;online, target : MLP&lt;br&gt;buffer : ReplayBuffer&lt;br&gt;optimizer : Adam&lt;br&gt;gamma, epsilon, batch_size&lt;br&gt;target_sync_steps, loss&lt;hr&gt;from_config(config, state_dim)&lt;br&gt;q_values(state) : ndarray&lt;br&gt;act(state, greedy) : int&lt;br&gt;update(s, a, r, s', done)&lt;br&gt;learn() : float&lt;br&gt;decay_epsilon()&lt;br&gt;save(path) / load(path)" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="880" y="250" width="440" height="260" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;MLP&lt;/b&gt;&lt;hr&gt;sizes : list&lt;br&gt;weights, biases&lt;hr&gt;forward(x) : ndarray&lt;br&gt;backward(grad_out)&lt;br&gt;copy_from(other)&lt;br&gt;save(path) / load(path)" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="700" y="700" width="340" height="158" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;ReplayBuffer&lt;/b&gt;&lt;hr&gt;capacity : int&lt;br&gt;state_dim : int&lt;hr&gt;add(s, a, r, s', done)&lt;br&gt;sample(batch_size)&lt;br&gt;__len__()" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1110" y="700" width="330" height="141" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Adam&lt;/b&gt;&lt;hr&gt;lr, beta1, beta2, eps&lt;br&gt;moment estimates&lt;hr&gt;step(dW, db)" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColo