<mxfile host="app.diagrams.net"><diagram id="er-diagram" name="er-diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Entity-relationship diagram&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1640" height="30" as="geometry"/></mxCell><mxCell id="c3" value="The data the system stores: YAML configs, route files, checkpoints (.npz) and result CSVs. PK = key, FK = reference." style="text;html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1640" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;INTERSECTION_CONFIG&lt;/b&gt;&lt;hr&gt;PK name&lt;br&gt;network_file, route_file, sumocfg_file&lt;br&gt;traffic_light_id&lt;br&gt;step_length, episode_length&lt;br&gt;decision_interval, yellow_duration&lt;br&gt;state_features, reward weights&lt;br&gt;dqn hyperparameters" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="330" height="153" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;APPROACH&lt;/b&gt;&lt;hr&gt;PK approach_id&lt;br&gt;FK config_name&lt;br&gt;name (east, north, west, south)&lt;br&gt;incoming_edge" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="330" height="102" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;PHASE&lt;/b&gt;&lt;hr&gt;PK phase_index&lt;br&gt;FK config_name&lt;br&gt;name (north_south_green, ...)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="330" height="85" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;SCENARIO&lt;/b&gt;&lt;hr&gt;PK scenario_name&lt;br&gt;FK config_name (extends)&lt;br&gt;description&lt;br&gt;route_file&lt;br&gt;vehicles_per_hour profile" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="320" height="119" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SWEEP&lt;/b&gt;&lt;hr&gt;PK sweep_id&lt;br&gt;grid (setting -&gt; values)&lt;br&gt;seeds&lt;br&gt;episodes, eval_episodes&lt;br&gt;out_dir" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="320" height="119" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;TRAINING_RUN&lt;/b&gt;&lt;hr&gt;PK run_id&lt;br&gt;FK sweep_id (optional)&lt;br&gt;FK config_name&lt;br&gt;agent_type (qtable, dqn)&lt;br&gt;setting (lr, gamma, decay, penalty)&lt;br&gt;seed, episodes" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="900" y="380" width="340" height="136" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;EPISODE_LOG&lt;/b&gt;&lt;hr&gt;PK (run_id, episode)&lt;br&gt;reward, epsilon, loss&lt;br&gt;mean_total_waiting&lt;br&gt;throughput_per_hour&lt;br&gt;switches" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1310" y="380" width="330" height="119" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;CHECKPOINT&lt;/b&gt;&lt;hr&gt;PK checkpoint_path (.npz)&lt;br&gt;FK run_id&lt;br&gt;hidden_sizes, state_dim&lt;br&gt;best_episode" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="340" height="102" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;EVALUATION_RESULT&lt;/b&gt;&lt;hr&gt;PK eval_id&lt;br&gt;FK checkpoint_path (null = fixed-time)&lt;br&gt;FK scenario_name&lt;br&gt;seed_base, episode&lt;br&gt;mean_total_waiting, mean_queue&lt;br&gt;mean_backlog, avg_wait_per_vehicle&lt;br&gt;throughput_per_hour, switches&lt;br&gt;ns_green_fraction" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="900" y="880" width="380" height="170" as="geometry"/></mxCell><mxCell id="c13" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;exitX=0;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="218"/><mxPoint x="30" y="610"/></Array></mxGeometry></mxCell><mxCell id="c15" value="is extended by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell