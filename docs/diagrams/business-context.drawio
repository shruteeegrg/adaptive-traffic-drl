<mxfile host="app.diagrams.net"><diagram id="business-context" name="business-context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Business context: Adaptive Traffic Signal Control&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1340" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Who and what the system deals with. Goal: fewer vehicles waiting than with a fixed timer." style="text;html=1;whiteSpace=wrap;fontSize=12;verticalAlign=top;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1340" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Adaptive Traffic Signal Control System&lt;/b&gt;&lt;br&gt;(traffic_drl: package, CLI, demo app)&lt;br&gt;&lt;br&gt;Learns a DQN signal controller and&lt;br&gt;compares it with a fixed-time controller" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;rounded=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="400" height="200" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Researcher / developer&lt;/b&gt;&lt;br&gt;configures, trains,&lt;br&gt;evaluates" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="250" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Supervisor / assessor&lt;/b&gt;&lt;br&gt;watches the demo,&lt;br&gt;reads the reports" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="250" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Traffic agencies and&lt;br&gt;smart-city planners&lt;/b&gt;&lt;br&gt;(intended beneficiaries)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="250" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SUMO traffic simulator&lt;/b&gt;&lt;br&gt;(external, via TraCI)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="1090" y="560" width="250" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Intersection and scenario definitions&lt;/b&gt;&lt;br&gt;YAML configs, network and route XML" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="525" y="80" width="350" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;code, configs, checkpoints, results" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;rounded=1;" vertex="1" parent="1"><mxGeometry x="525" y="660" width="350" height="90" as="geometry"/></mxCell><mxCell id="c11" value="commands: train, sweep, evaluate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;edgeStyle=none;exitX=1;exitY=0.9;entryX=0;entryY=0.05;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="metrics, plots, checkpoints" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;edgeStyle=none;exitX=0;exitY=0.3;entryX=0.8;entryY=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="asks for a demo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;e